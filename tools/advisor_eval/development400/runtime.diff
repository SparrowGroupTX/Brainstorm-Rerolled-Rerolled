+local function supported_copy_priority(snapshot,sold,card,after,evidence)
+    local function finite(v) return type(v)=='number' and v==v and math.abs(v)<math.huge end
+    if snapshot.teacher_profile~='perkeo_yorick_win_v1' or not card or
+        (card.key~='j_blueprint' and card.key~='j_brainstorm') or card.debuff or card.unknown or
+        card.identity_redacted or card.face_down or
+        ability(card).perishable and num(ability(card).perish_tally,5)<2 or not useful_copy_target(snapshot) then return false end
+    if sold and (sold.pinned or ability(sold).pinned or ability(sold).eternal or edition(sold,'negative') or
+        ({j_yorick=true,j_perkeo=true,j_blueprint=true,j_brainstorm=true})[sold.key]) then return false end
+    if not after or not finite(after.dollars) or after.dollars<copy_cash_reserve(after) or
+        not evidence or evidence.incomplete or evidence.uncertain or evidence.samples~=4 or
+        not evidence.complete_finishing or not finite(evidence.ratio) or evidence.ratio<1.05 or
+        not finite(evidence.before_target) or evidence.before_target<=0 or evidence.before_target~=evidence.after_target then return false end
+    local worlds=evidence.common_worlds
+    if not worlds or worlds.kind~='shop_four_common_worlds_v1' or worlds.samples~=4 or
+        type(worlds.family_key)~='string' or worlds.family_key=='' or type(worlds.world_ids)~='table' or #worlds.world_ids~=4 then return false end
+    local before,following=evidence.before_finishing,evidence.after_finishing
+    for _,f in ipairs({before or {},following or {}}) do
+        if not f.complete or not f.supported or not f.known_mechanics or f.samples~=4 or
+            not f.selected or type(f.selected.worlds)~='table' or #f.selected.worlds~=4 then return false end
+    end
+    if following.selected.clearing_samples~=4 then return false end
+    for i=1,4 do
+        local a,b=before.selected.worlds[i],following.selected.worlds[i]
+        if worlds.world_ids[i]~=i or type(a)~='table' or type(b)~='table' or type(a.clear)~='boolean' or
+            b.clear~=true or not finite(a.progress) or not finite(b.progress) or a.progress<0 or a.progress>1 or
+            b.progress<0 or b.progress>1 or b.progress+0.000000001<a.progress then return false end
+    end
