+s=F.state();s.blind={key='bl_flint',name='The Flint',chips=350}
+s.hand={};for i,r in ipairs({13,13,10,8,6,4,2}) do s.hand[i]=F.card('flint'..i,r,({'Clubs','Spades','Diamonds','Hearts'})[(i-1)%4+1],i==1 and 'm_mult' or 'c_base') end
