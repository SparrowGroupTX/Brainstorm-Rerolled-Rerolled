+-- Run this small declared family before optional purchases and broader shop
+-- sequences. It uses the same supported transitions and all legal sale victims,
+-- then publishes exactly one step. An incomplete family never yields a prefix.
+function Strategy.copy_acquisition(snapshot,context)
+    if snapshot.phase~='shop' or snapshot.teacher_profile~='perkeo_yorick_win_v1' or
+        not context or not useful_copy_target(snapshot) then return end
+    local visible=false
+    for _,c in ipairs(snapshot.shop_jokers or {}) do
+        if c.key=='j_blueprint' or c.key=='j_brainstorm' then visible=true end
+    end
+    if not visible then return end
+    local state=copy_table(snapshot);state._copy_acquisition=true;state._shop_scoring=context
+    local best=best_shop_purchase(state,deck_stats(state),components(state),true)
+    local replacement=replacement_sale_plan(state,best,best_shop_purchase)
+    local receipt=context.replacement_diagnostics
+    if context.truncated or receipt and not receipt.complete then return nil,receipt end
+    if replacement and replacement.copy_priority then return replacement_sale_advice(snapshot,replacement),receipt end
+    if best and best.copy_priority then
+        return {title='Buy '..name(best.card)..' ($'..num(best.card.cost)..')',lines={best.reason,
+          'Acquire the visible copy while its cash and slot are available; all four supported next-blind finishes remain.'},warnings={},
+          action={kind='buy',area=best.area,index=best.index},scoring_evidence=best.scoring_evidence,
+          copy_acquisition_review={schema=1,complete=true,reason='supported_copy_priority',selected_offer=best.index}},receipt
+    end
+    return nil,receipt
 end
 
